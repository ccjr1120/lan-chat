<?xml version="1.0" encoding="utf-8"?>
<!-- 局域网内设备之间使用明文 HTTP/WS 通信（无公网证书），需允许 cleartext。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
